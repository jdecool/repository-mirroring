# GitHub token — optional, if absent the script uses `gh auth token`
# (requires being authenticated via `gh auth login`)
GITHUB_TOKEN=

# GitHub username that owns the repositories to mirror
GITHUB_USER=

# Codeberg (Forgejo)
# API token to create at https://codeberg.org/user/settings/applications
# with the "repository" scope (read + write)
CODEBERG_TOKEN=

# Your Codeberg username (destination for the repositories)
CODEBERG_USER=

# Codeberg API URL (leave as is unless using a different Forgejo instance)
CODEBERG_API=https://codeberg.org/api/v1

# Sync GitHub releases to Codeberg (true/false, default: true)
SYNC_RELEASES=true

# Sync release assets (true/false, default: true)
SYNC_RELEASE_ASSETS=true

# rickub (https://rickub.com)
# Personal access token starting with rickub_pat_
# Create one at https://rickub.com/settings/tokens (Full access required)
RICKUB_TOKEN=

# Your rickub username (handle)
RICKUB_USER=

# rickub API URL (leave as is unless using a different instance)
RICKUB_API=https://rickub.com/api/v1

# rickub git host for HTTPS clone/push operations
RICKUB_GIT_HOST=git.rickub.com
