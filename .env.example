# GitHub token — optional, if absent the script uses `gh auth token`
# (requires being authenticated via `gh auth login`)
GITHUB_TOKEN=

# GitHub username that owns the repositories to mirror
GITHUB_USER=

# Codeberg (Forgejo)
# API token to create at https://codeberg.org/user/settings/applications
# with the "repository" scope (read + write)
CODEBERG_TOKEN=

# Your Codeberg username (destination for the repositories)
CODEBERG_USER=

# Codeberg API URL (leave as is unless using a different Forgejo instance)
CODEBERG_API=https://codeberg.org/api/v1
